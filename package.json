{
  "name": "mmodels-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "MModels · 本地数学建模智能体桌面版",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "npm run typecheck && npm run test:unit && npm run test:harness",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:harness": "node scripts/test-git.cjs && node scripts/test-env.cjs && node scripts/test-claude-path.mjs",
    "test:native": "node scripts/clean-env.cjs node_modules/electron/dist/electron.exe scripts/test-native-abi.mjs",
    "test:e2e": "node scripts/test-real-app.cjs",
    "pack:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "dist": "electron-vite build && electron-builder --win --x64",
    "dist:portable": "electron-vite build && electron-builder --win portable --x64",
    "postinstall": "node scripts/ensure-native.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.224",
    "@hono/node-server": "^1.19.4",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "better-sqlite3": "^12.11.0",
    "bonjour-service": "^1.4.4",
    "chokidar": "^4.0.3",
    "conf": "^13.1.0",
    "diff-match-patch": "^1.0.5",
    "drizzle-orm": "^0.44.2",
    "electron-updater": "^6.6.2",
    "hono": "^4.12.0",
    "lib0": "^0.2.117",
    "node-pty": "^1.0.0",
    "which": "6.0.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.4",
    "electron": "43.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "katex": "^0.18.7",
    "marked": "^15.0.7",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.0.0",
    "node-gyp": "^11.5.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "split-type": "^0.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "node-pty",
      "esbuild"
    ]
  }
}
