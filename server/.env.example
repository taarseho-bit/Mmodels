# 复制成 .env 后填写。⚠️ .env 不要提交进 git。

# 域名：必须已经解析到这台服务器的 IP，Caddy 才能申请到证书
DIAG_DOMAIN=diag.example.com

# 访问令牌：客户端用它做 Bearer 鉴权，同时是 /admin 的登录密码
# 生成方式：openssl rand -hex 32
# ⚠️ 这个值会随客户端分发出去，一定会被提取到 ——
#    它的作用是挡扫描器与限流，**不是机密**。详见 ../诊断服务-自建指南.md
# 默认仅本机访问；需要局域网时显式改为 0.0.0.0，并配合防火墙/反向代理。
DIAG_HOST=127.0.0.1

DIAG_TOKEN=please_replace_with_openssl_rand_hex_32

# 数据保留期（天）。到期自动清理遥测分片与诊断报告。
DIAG_RETENTION_DAYS=30

# 每 IP 每分钟请求数上限
DIAG_RATE_PER_MIN=120

# 邮件通知里的「去诊断台看」链接前缀。填你的域名。
PUBLIC_BASE_URL=https://diag.example.com

# ─────────────────────────────────────────────────────────────
# 邮件通知（可选）。**留空即关闭**，不配也能正常收数据。
#
# ⚠️ 邮件只做通知，正文里是摘要 + 链接，不带日志附件。
# ⚠️ 这些凭据只能放在服务端 —— 绝不要放进桌面客户端直连发信，
#    客户端会随安装包泄露，SMTP 凭据泄露会导致你的发信域名被拉黑。
# ─────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=you@qq.com
# SMTP_PASS=授权码（不是登录密码）
# MAIL_FROM=you@qq.com
# MAIL_TO=you@qq.com
# 一小时内最多发几封通知，防灌爆邮箱
# MAIL_MAX_PER_HOUR=20
